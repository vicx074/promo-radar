ADMIN_API_KEY=REPLACE_WITH_LONG_RANDOM_KEY
EVOLUTION_API_KEY=REPLACE_WITH_DIFFERENT_RANDOM_KEY
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_PASSWORD
EVOLUTION_INSTANCE=promocoes
WHATSAPP_GROUP_ID=
SEND_ENABLED=false
SQLITE_PATH=data/offers.db
# URL usada somente quando o backend roda fora do Docker.
# Docker Compose injeta http://evolution:8080 no container bot.
EVOLUTION_BASE_URL=http://localhost:8085

# VPS privada: crie hash Argon2id com python -m app.auth hash-password.
# Nunca grave a senha em texto simples, nem publique o hash em commits.
# OWNER_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=2$...'
OWNER_PASSWORD_HASH=
# Defina true na VPS privada depois de preencher OWNER_PASSWORD_HASH.
SINGLE_OWNER_MODE=false
ALLOW_ADMIN_API_KEY=true
# Na VPS com Tailscale Serve HTTPS, sempre true.
SESSION_COOKIE_SECURE=true

# Busca real por nicho via Actor de scraping terceirizado da Apify.
# Não use credenciais da conta Mercado Livre. Token fica somente na VPS.
DISCOVERY_PROVIDER=apify
APIFY_TOKEN=
# Para usar arquivo local explicitamente: DISCOVERY_PROVIDER=csv
